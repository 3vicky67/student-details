managed implementation in class ZBP_R_CIT_STUDCT_HDR unique;
strict ( 2 );
with draft;
extensible;
define behavior for ZR_CIT_STUDCT_HDR alias ZrCitStudctHdr
persistent table ZCIT_STUDCT_HDR
extensible
draft table ZCIT_STDCT_HDR_D
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master( global )
{
  field ( readonly )
   StudentID,
   CreatedBy,
   LastChangedBy,
   LocalLastChangedAt,
   LastChangedAt;

  field ( numbering : managed )
   StudentID;


  create;
  update;
  delete;

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  mapping for ZCIT_STUDCT_HDR corresponding extensible
  {
    StudentID = STUDENT_ID;
    FirstName = FIRST_NAME;
    LastName = LAST_NAME;
    Dob = DOB;
    Gender = GENDER;
    Email = EMAIL;
    PhoneNumber = PHONE_NUMBER;
    Address = ADDRESS;
    City = CITY;
    State = STATE;
    Pincode = PINCODE;
    Country = COUNTRY;
    CourseName = COURSE_NAME;
    Department = DEPARTMENT;
    Semester = SEMESTER;
    CreatedBy = CREATED_BY;
    LastChangedBy = LAST_CHANGED_BY;
    LocalLastChangedAt = LOCAL_LAST_CHANGED_AT;
    LastChangedAt = LAST_CHANGED_AT;
  }

}